# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas M0 Free Tier URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hommiez?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=7d

# College Domain Rule (Optional for strict student verification)
# Example: "northeastern.edu" or "thapar.edu" or "vit.ac.in"
ALLOWED_COLLEGE_EMAIL_DOMAIN=college.edu

# Cloudinary (Zero-cost free tier image storage, 25 GB free forever)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
